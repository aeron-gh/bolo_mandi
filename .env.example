# Copy this file to .env.local and fill it in. .env.local is never committed.

# The address people open. Used for Google's return address and redirects.
APP_ORIGIN=http://localhost:3000

# Google login (optional). Without both values the Google button is hidden.
# Create an OAuth client (type "Web application") in Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Folder for accounts.db, demo.db and shops/<user id>.db. Put it on the server's persistent disk.
# Default: ./data
BOLO_DATA_DIR=

# Sarvam streaming speech (optional, used by npm run dev:sarvam / start:sarvam).
SARVAM_API_KEY=
